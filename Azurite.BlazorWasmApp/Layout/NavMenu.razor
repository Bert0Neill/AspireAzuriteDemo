<div class="top-row ps-3 navbar navbar-dark">
    <div class="container-fluid">
        <a class="navbar-brand" href="">Azurite.BlazorWasmApp</a>
        <button title="Navigation menu" class="navbar-toggler" @onclick="ToggleNavMenu">
            <span class="navbar-toggler-icon"></span>
        </button>
    </div>
</div>

<div class="@NavMenuCssClass nav-scrollable" @onclick="ToggleNavMenu">
    <nav class="nav flex-column">
        <div class="nav-item px-3">
            <NavLink class="nav-link" href="" Match="NavLinkMatch.All">
                <span class="bi bi-house-door-fill-nav-menu" aria-hidden="true"></span> Home
            </NavLink>
        </div>
        <div class="nav-item px-3">
            <NavLink class="nav-link" href="blob">
                <span class="oi oi-cloud-upload" aria-hidden="true"></span> Blob Storage
            </NavLink>
        </div>
        <div class="nav-item px-3">
            <NavLink class="nav-link" href="table">
                <span class="oi oi-table" aria-hidden="true"></span> Table Storage
            </NavLink>
        </div>
        <div class="nav-item px-3">
            <NavLink class="nav-link" href="queue">
                <span class="oi oi-list" aria-hidden="true"></span> Queue Storage
            </NavLink>
        </div>
        <div class="nav-item px-3">
            <NavLink class="nav-link" href="vault">
                <span class="oi oi-lock-locked" aria-hidden="true"></span> Key Vault
            </NavLink>
        </div>
        <div class="nav-item px-3">
            <NavLink class="nav-link" href="servicebus">
                <span class="oi oi-envelope-closed" aria-hidden="true"></span> Service Bus
            </NavLink>
        </div>
        <div class="nav-item px-3">
            <NavLink class="nav-link" href="messages">
                <span class="oi oi-chat" aria-hidden="true"></span> SignalR Chat
            </NavLink>
        </div>
    </nav>
</div>

@code {
    private bool collapseNavMenu = true;

    private string? NavMenuCssClass => collapseNavMenu ? "collapse" : null;

    private void ToggleNavMenu()
    {
        collapseNavMenu = !collapseNavMenu;
    }
}
