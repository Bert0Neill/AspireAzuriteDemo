@page "/table"
@using Azurite.BlazorWasmApp.Infrastructure
@inject ApiService ApiService

<PageTitle>Table Storage Demo</PageTitle>

<div class="container mt-4">
    <h2>Azure Table Storage (Azurite)</h2>
    
    <div class="row mb-3">
        <div class="col-md-6">
            <div class="card">
                <div class="card-header">
                    <h5>Add Entity</h5>
                </div>
                <div class="card-body">
                    <div class="mb-2">
                        <label class="form-label">Partition Key:</label>
                        <input @bind="newPartitionKey" class="form-control" />
                    </div>
                    <div class="mb-2">
                        <label class="form-label">Row Key:</label>
                        <input @bind="newRowKey" class="form-control" />
                    </div>
                    <div class="mb-2">
                        <label class="form-label">Data:</label>
                        <input @bind="newData" class="form-control" />
                    </div>
                    <button class="btn btn-primary" @onclick="AddEntity" disabled="@adding">
                        @if (adding)
                        {
                            <span class="spinner-border spinner-border-sm me-2"></span>
                        }
                        Add Entity
                    </button>
                    @if (!string.IsNullOrEmpty(message))
                    {
                        <div class="alert alert-@(success ? "success" : "danger") mt-2">@message</div>
                    }
                </div>
            </div>
        </div>
    </div>

    <div class="row">
        <div class="col-12">
            <div class="card">
                <div class="card-header d-flex justify-content-between align-items-center">
                    <h5>Entities (@entities.Count)</h5>
                    <button class="btn btn-sm btn-secondary" @onclick="RefreshEntities" disabled="@loading">
                        @if (loading)
                        {
                            <span class="spinner-border spinner-border-sm me-2"></span>
                        }
                        Refresh
                    </button>
                </div>
                <div class="card-body">
                    @if (loading)
                    {
                        <p>Loading...</p>
                    }
                    else if (entities.Any())
                    {
                        <table class="table table-striped">
                            <thead>
                                <tr>
                                    <th>Partition Key</th>
                                    <th>Row Key</th>
                                    <th>Data</th>
                                    <th>Actions</th>
                                </tr>
                            </thead>
                            <tbody>
                                @foreach (var entity in entities)
                                {
                                    <tr>
                                        <td>@entity.PartitionKey</td>
                                        <td>@entity.RowKey</td>
                                        <td>@entity.Data</td>
                                        <td>
                                            <button class="btn btn-sm btn-danger" @onclick="() => DeleteEntity(entity.PartitionKey, entity.RowKey)">
                                                Delete
                                            </button>
                                        </td>
                                    </tr>
                                }
                            </tbody>
                        </table>
                    }
                    else
                    {
                        <p class="text-muted">No entities found. Add an entity to get started.</p>
                    }
                </div>
            </div>
        </div>
    </div>
</div>

@code {
    private List<TableEntityInfo> entities = new();
    private bool loading = false;
    private bool adding = false;
    private string message = "";
    private bool success = false;
    private string newPartitionKey = "";
    private string newRowKey = "";
    private string newData = "";

    protected override async Task OnInitializedAsync()
    {
        await RefreshEntities();
    }

    private async Task RefreshEntities()
    {
        loading = true;
        try
        {
            entities = await ApiService.ListTableEntitiesAsync();
        }
        catch (Exception ex)
        {
            message = $"Error: {ex.Message}";
            success = false;
        }
        finally
        {
            loading = false;
            StateHasChanged();
        }
    }

    private async Task AddEntity()
    {
        if (string.IsNullOrWhiteSpace(newPartitionKey) || string.IsNullOrWhiteSpace(newRowKey))
        {
            message = "Partition Key and Row Key are required";
            success = false;
            return;
        }

        adding = true;
        message = "";
        try
        {
            await ApiService.AddTableEntityAsync(newPartitionKey, newRowKey, newData);
            message = "Entity added successfully!";
            success = true;
            newPartitionKey = "";
            newRowKey = "";
            newData = "";
            await RefreshEntities();
        }
        catch (Exception ex)
        {
            message = $"Add failed: {ex.Message}";
            success = false;
        }
        finally
        {
            adding = false;
        }
    }

    private async Task DeleteEntity(string partitionKey, string rowKey)
    {
        try
        {
            await ApiService.DeleteTableEntityAsync(partitionKey, rowKey);
            await RefreshEntities();
        }
        catch (Exception ex)
        {
            message = $"Delete failed: {ex.Message}";
            success = false;
        }
    }
}

