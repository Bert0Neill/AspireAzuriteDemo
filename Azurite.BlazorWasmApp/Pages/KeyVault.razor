@page "/vault"
@using Azurite.BlazorWasmApp.Infrastructure
@inject ApiService ApiService

<PageTitle>Key Vault Demo</PageTitle>

<div class="container mt-4">
    <h2>Azure Key Vault (Azurite)</h2>
    
    <div class="row mb-3">
        <div class="col-md-6">
            <div class="card">
                <div class="card-header">
                    <h5>Set Secret</h5>
                </div>
                <div class="card-body">
                    <div class="mb-2">
                        <label class="form-label">Secret Name:</label>
                        <input @bind="newSecretName" class="form-control" />
                    </div>
                    <div class="mb-2">
                        <label class="form-label">Secret Value:</label>
                        <input @bind="newSecretValue" type="password" class="form-control" />
                    </div>
                    <button class="btn btn-primary" @onclick="SetSecret" disabled="@setting">
                        @if (setting)
                        {
                            <span class="spinner-border spinner-border-sm me-2"></span>
                        }
                        Set Secret
                    </button>
                    @if (!string.IsNullOrEmpty(message))
                    {
                        <div class="alert alert-@(success ? "success" : "danger") mt-2">@message</div>
                    }
                </div>
            </div>
        </div>
        <div class="col-md-6">
            <div class="card">
                <div class="card-header">
                    <h5>Get Secret</h5>
                </div>
                <div class="card-body">
                    <div class="mb-2">
                        <label class="form-label">Secret Name:</label>
                        <input @bind="getSecretName" class="form-control" />
                    </div>
                    <button class="btn btn-info" @onclick="GetSecret" disabled="@getting">
                        @if (getting)
                        {
                            <span class="spinner-border spinner-border-sm me-2"></span>
                        }
                        Get Secret
                    </button>
                    @if (!string.IsNullOrEmpty(retrievedSecret))
                    {
                        <div class="alert alert-info mt-2">
                            <strong>Value:</strong> @retrievedSecret
                        </div>
                    }
                </div>
            </div>
        </div>
    </div>

    <div class="row">
        <div class="col-12">
            <div class="card">
                <div class="card-header d-flex justify-content-between align-items-center">
                    <h5>Secrets (@secrets.Count)</h5>
                    <button class="btn btn-sm btn-secondary" @onclick="RefreshSecrets" disabled="@loading">
                        @if (loading)
                        {
                            <span class="spinner-border spinner-border-sm me-2"></span>
                        }
                        Refresh
                    </button>
                </div>
                <div class="card-body">
                    @if (loading)
                    {
                        <p>Loading...</p>
                    }
                    else if (secrets.Any())
                    {
                        <table class="table table-striped">
                            <thead>
                                <tr>
                                    <th>Name</th>
                                    <th>Actions</th>
                                </tr>
                            </thead>
                            <tbody>
                                @foreach (var secret in secrets)
                                {
                                    <tr>
                                        <td>@secret.Name</td>
                                        <td>
                                            <button class="btn btn-sm btn-info me-2" @onclick="() => GetSecretByName(secret.Name)">
                                                Get Value
                                            </button>
                                            <button class="btn btn-sm btn-danger" @onclick="() => DeleteSecret(secret.Name)">
                                                Delete
                                            </button>
                                        </td>
                                    </tr>
                                }
                            </tbody>
                        </table>
                    }
                    else
                    {
                        <p class="text-muted">No secrets found. Set a secret to get started.</p>
                    }
                </div>
            </div>
        </div>
    </div>
</div>

@code {
    private List<SecretInfo> secrets = new();
    private bool loading = false;
    private bool setting = false;
    private bool getting = false;
    private string message = "";
    private bool success = false;
    private string newSecretName = "";
    private string newSecretValue = "";
    private string getSecretName = "";
    private string retrievedSecret = "";

    protected override async Task OnInitializedAsync()
    {
        await RefreshSecrets();
    }

    private async Task RefreshSecrets()
    {
        loading = true;
        try
        {
            secrets = await ApiService.ListSecretsAsync();
        }
        catch (Exception ex)
        {
            message = $"Error: {ex.Message}";
            success = false;
        }
        finally
        {
            loading = false;
            StateHasChanged();
        }
    }

    private async Task SetSecret()
    {
        if (string.IsNullOrWhiteSpace(newSecretName) || string.IsNullOrWhiteSpace(newSecretValue))
        {
            message = "Secret name and value are required";
            success = false;
            return;
        }

        setting = true;
        message = "";
        try
        {
            await ApiService.SetSecretAsync(newSecretName, newSecretValue);
            message = "Secret set successfully!";
            success = true;
            newSecretName = "";
            newSecretValue = "";
            await RefreshSecrets();
        }
        catch (Exception ex)
        {
            message = $"Set failed: {ex.Message}";
            success = false;
        }
        finally
        {
            setting = false;
        }
    }

    private async Task GetSecret()
    {
        if (string.IsNullOrWhiteSpace(getSecretName))
        {
            message = "Secret name is required";
            success = false;
            return;
        }

        getting = true;
        retrievedSecret = "";
        try
        {
            var value = await ApiService.GetSecretAsync(getSecretName);
            if (value != null)
            {
                retrievedSecret = value;
            }
            else
            {
                message = "Secret not found";
                success = false;
            }
        }
        catch (Exception ex)
        {
            message = $"Get failed: {ex.Message}";
            success = false;
        }
        finally
        {
            getting = false;
        }
    }

    private async Task GetSecretByName(string name)
    {
        getSecretName = name;
        await GetSecret();
    }

    private async Task DeleteSecret(string name)
    {
        try
        {
            await ApiService.DeleteSecretAsync(name);
            await RefreshSecrets();
            if (getSecretName == name)
            {
                retrievedSecret = "";
            }
        }
        catch (Exception ex)
        {
            message = $"Delete failed: {ex.Message}";
            success = false;
        }
    }
}

