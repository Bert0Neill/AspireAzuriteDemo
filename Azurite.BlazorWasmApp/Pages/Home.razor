@page "/"

<PageTitle>Azurite Demo - Home</PageTitle>

<div class="container mt-4">
    <div class="row">
        <div class="col-12">
            <h1>Azure Services Local Emulator Demo</h1>
            <p class="lead">This application demonstrates using Azurite and other Azure emulators locally with .NET Aspire.</p>
        </div>
    </div>

    <div class="row mt-4">
        <div class="col-md-4 mb-4">
            <div class="card h-100">
                <div class="card-body">
                    <h5 class="card-title">
                        <span class="oi oi-cloud-upload me-2"></span>Blob Storage
                    </h5>
                    <p class="card-text">Upload, download, list, and delete blobs using Azurite Blob Storage emulator.</p>
                    <a href="/blob" class="btn btn-primary">Try Blob Storage</a>
                </div>
            </div>
        </div>

        <div class="col-md-4 mb-4">
            <div class="card h-100">
                <div class="card-body">
                    <h5 class="card-title">
                        <span class="oi oi-table me-2"></span>Table Storage
                    </h5>
                    <p class="card-text">Create, read, update, and delete entities using Azurite Table Storage emulator.</p>
                    <a href="/table" class="btn btn-primary">Try Table Storage</a>
                </div>
            </div>
        </div>

        <div class="col-md-4 mb-4">
            <div class="card h-100">
                <div class="card-body">
                    <h5 class="card-title">
                        <span class="oi oi-list me-2"></span>Queue Storage
                    </h5>
                    <p class="card-text">Send and receive messages using Azurite Queue Storage emulator.</p>
                    <a href="/queue" class="btn btn-primary">Try Queue Storage</a>
                </div>
            </div>
        </div>

        <div class="col-md-4 mb-4">
            <div class="card h-100">
                <div class="card-body">
                    <h5 class="card-title">
                        <span class="oi oi-lock-locked me-2"></span>Key Vault
                    </h5>
                    <p class="card-text">Store and retrieve secrets using Azurite Key Vault emulator.</p>
                    <a href="/vault" class="btn btn-primary">Try Key Vault</a>
                </div>
            </div>
        </div>

        <div class="col-md-4 mb-4">
            <div class="card h-100">
                <div class="card-body">
                    <h5 class="card-title">
                        <span class="oi oi-envelope-closed me-2"></span>Service Bus
                    </h5>
                    <p class="card-text">Send messages to Azure Service Bus emulator queue.</p>
                    <a href="/servicebus" class="btn btn-primary">Try Service Bus</a>
                </div>
            </div>
        </div>

        <div class="col-md-4 mb-4">
            <div class="card h-100">
                <div class="card-body">
                    <h5 class="card-title">
                        <span class="oi oi-chat me-2"></span>SignalR
                    </h5>
                    <p class="card-text">Real-time messaging using Azure SignalR emulator.</p>
                    <a href="/messages" class="btn btn-primary">Try SignalR Chat</a>
                </div>
            </div>
        </div>
    </div>

    <div class="row mt-4">
        <div class="col-12">
            <div class="alert alert-info">
                <h5>About This Demo</h5>
                <p>This application uses .NET Aspire to orchestrate multiple Azure emulators running locally:</p>
                <ul>
                    <li><strong>Azurite</strong> - Provides Blob, Queue, and Table Storage emulation</li>
                    <li><strong>Azure Service Bus Emulator</strong> - Provides Service Bus queue emulation</li>
                    <li><strong>Azure SignalR Emulator</strong> - Provides SignalR service emulation</li>
                    <li><strong>Azure Key Vault Emulator</strong> - Provides Key Vault emulation</li>
                    <li><strong>Azure Functions</strong> - Processes Service Bus messages and sends to SignalR</li>
                </ul>
                <p class="mb-0">All services run locally without connecting to Azure cloud services.</p>
            </div>
        </div>
    </div>
</div>
